#===========================================
# ====== Relay Engine
# ==========================================
SERVICE_PORT=3000
SERVICE_VERSION="1.0.0"
SERVICE_DOMAIN="localhost"
SERVICE_NAME="relay-engine"
SERVICE_CLIENT="http://localhost:5768"

# ==========================================
# ====== PostgreSQL
# ==========================================
POSTGRES_SAMPLER_URL="postgresql://sampler:<sampler_password>@localhost:5432/relay"
POSTGRES_RUNNER_URL="postgresql://runner:<runnner_password>@localhost:5432/relay"

# ==========================================
# ======= CORS Policy
# ==========================================
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
